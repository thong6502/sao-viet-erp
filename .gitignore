# Python / FastAPI backend
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.sqlite3
*.db

# Node / React + Vite frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Env / secrets — KHÔNG BAO GIỜ commit, kể cả .env.prod/.env.stg cục bộ.
# Bản mẫu duy nhất trong git là .env.example (có khối "TRIỂN KHAI THẬT" liệt kê thứ phải đổi).
# Đã cân nhắc commit sẵn .env.prod/.env.stg cho tiện `cp` rồi BỎ: secret vào lịch sử git là
# không gỡ ra được.
.env
.env.*
!.env.example

# Playwright MCP browser-validate artifacts (snapshots, screenshots)
.playwright-mcp/

# Runtime server logs (uvicorn / vite / eval helpers: _uv_*.log, _vite_run.log, _eval_*.log…)
*.log

# User-uploaded avatars = runtime content, not source (tests/validate sinh ảnh 1×1 mỗi lần)
backend/static/avatars/
# Hồ sơ nhân sự upload (CCCD…) = runtime + dữ liệu cá nhân nhạy cảm, KHÔNG commit
backend/static/hr/
backend/static/crm/
# File đính kèm phiếu kho / lệnh sản xuất / phiếu chi + phiếu thu kế toán = runtime content
backend/static/kho/
backend/static/san-xuat/
backend/static/ke-toan/
backend/static/ke-toan-thu/
# File đính kèm đơn hàng (PO khách) / chứng từ cọc (ủy nhiệm chi) = runtime content
backend/static/don-hang/
backend/static/don-hang-coc/
Backend/static/noi-quy/
Backend/static/bao-gia/
Backend/static/giao-hang/

