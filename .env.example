# ============================================================================
# BẢN MẪU DUY NHẤT cho `.env` ở gốc — file mà `docker compose` đọc.
# Chép sang `.env` (đã gitignore, KHÔNG BAO GIỜ commit) rồi chỉnh.
#
#   cp .env.example .env
#
# Giá trị dưới đây là mặc định AN TOÀN CHO MÁY DEV. Triển khai thật thì xem
# khối "TRIỂN KHAI THẬT" ở cuối file — có danh sách đúng những gì phải đổi.
#
# LƯU Ý: đây KHÔNG phải file cấu hình của backend chạy trực tiếp trên máy.
# `./dev.ps1` (uvicorn trên host) đọc `backend/.env`; frontend dev đọc
# `frontend/.env`. Ba file, ba mục đích — đừng trộn.
# ============================================================================

# --- Tên project + cổng ---
# Tên project tách container/volume của môi trường này khỏi môi trường khác
# (chạy chung một máy cũng không đè nhau).
COMPOSE_PROJECT_NAME=erp-svn-local
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_DOMAIN=localhost

# --- PostgreSQL (service db) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=gan_app

# --- Backend auth ---
# KHÔNG khai APP_ENV ở đây: compose ghi cứng `APP_ENV: production` cho service backend
# (không cho phép lỡ tay deploy với guard JWT tắt).
# Sinh secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Tài khoản admin seed (đăng nhập bằng SEED_ADMIN_USERNAME) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
SEED_DEMO=true

# --- CORS: origin frontend được phép gọi API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- URL backend mà bundle FE sẽ gọi (nướng vào lúc BUILD image `web`) ---
# RỖNG = same-origin: client gọi /api tương đối, nginx trong image proxy sang backend.
# Đây là giá trị đúng cho mọi triển khai có Caddy/nginx đứng trước. Chỉ đặt khác khi FE và BE
# nằm ở hai tên miền khác nhau (vd https://api.example.com).
# Đổi biến này phải `up --build` lại service `web` thì bundle mới nhận.
VITE_API_BASE_URL=

# --- MinIO (kho file) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=svn-files

# --- Cổng loopback của Redis/MinIO ---
# Lệch mặc định 6379/9000/9001 vì chúng hay bị service khác chiếm sẵn (trên VPS thì 5432 và
# 9001 đã thuộc stack myanphu-staging). Chỉ publish 127.0.0.1, không ra Internet.
REDIS_PORT=6380
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9002

# REDIS_URL và MINIO_ENDPOINT do docker-compose.prod.yml đặt sẵn (trỏ vào service nội bộ),
# không cần khai ở đây.

# ============================================================================
# TRIỂN KHAI THẬT — đổi đúng những dòng này rồi mới `up`
#
#   COMPOSE_PROJECT_NAME  erp-svn            (staging: erp-svn-stg)
#   HTTP_PORT / HTTPS_PORT  80 / 443         (staging chung VPS: 8090 / 8443)
#   SITE_DOMAIN           svn.superbai.io    (staging: stg.svn.superbai.io)
#   CORS_ORIGINS          https://<SITE_DOMAIN>
#   SEED_DEMO             false              (production: KHÔNG seed dữ liệu demo)
#   REDIS_PORT / MINIO_API_PORT / MINIO_CONSOLE_PORT
#                         phải LỆCH giữa prod và staging nếu chạy chung một VPS
#
#   Sinh mới, KHÔNG dùng lại giá trị dev — mỗi cái một chuỗi ngẫu nhiên riêng:
#   JWT_SECRET (≥32 ký tự, thiếu là backend TỪ CHỐI khởi động)
#   POSTGRES_PASSWORD · SEED_ADMIN_PASSWORD · MINIO_ROOT_USER · MINIO_ROOT_PASSWORD
#
# `deploy.yml` kiểm các khoá này trước khi `up`; thiếu là dừng ngay kèm thông báo,
# không để backend crash-loop.
# ============================================================================
