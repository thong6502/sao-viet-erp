# Root env for docker-compose. Copy to `.env` (gitignored) and adjust.
# Secrets load from the environment — never commit a real .env (docs/SECURITY.md).

# --- PostgreSQL (db service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=gan_app

# --- Backend auth ---
# Deployment environment. With APP_ENV=production the backend REFUSES to start
# unless JWT_SECRET is a strong (>=32 random chars), non-default value.
APP_ENV=development
# CHANGE this in any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded admin user (no self-registration this spec). Login is by SEED_ADMIN_USERNAME.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin

# Allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
