# Root env for docker-compose. Copy to `.env` (gitignored) and adjust.
# Secrets load from the environment — never commit a real .env (docs/SECURITY.md).

# --- PostgreSQL (db service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=gan_app

# --- Backend auth ---
# CHANGE this in any real deployment.
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded admin user (no self-registration this sprint).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin

# Allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
