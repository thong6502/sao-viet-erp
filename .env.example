# ============================================================================
# BẢN MẪU DUY NHẤT cho `.env` ở gốc — file mà `docker compose` đọc.
# Chép sang `.env` (đã gitignore, KHÔNG BAO GIỜ commit) rồi chỉnh.
#
#   cp .env.example .env
#
# Giá trị dưới đây là mặc định AN TOÀN CHO MÁY DEV. Triển khai thật thì xem
# khối "TRIỂN KHAI THẬT" ở cuối file — có danh sách đúng những gì phải đổi.
#
# LƯU Ý: đây KHÔNG phải file cấu hình của backend chạy trực tiếp trên máy.
# `./dev.ps1` (uvicorn trên host) đọc `backend/.env`; frontend dev đọc
# `frontend/.env`. Ba file, ba mục đích — đừng trộn.
# ============================================================================

# --- CHỌN SERVICE NÀO ĐƯỢC DỰNG ---
# Lệnh luôn chỉ là `docker compose up -d --build`; biến này quyết dựng cái gì.
#   MÁY DEV : db,redis,minio
#             → chỉ hạ tầng. KHÔNG có caddy nên KHÔNG xin chứng chỉ.
#               Backend + frontend chạy ngoài bằng ./dev.ps1 (có hot-reload).
#   TRIỂN KHAI: db,redis,minio,backend,web,caddy
#             → full stack kèm TLS.
# Đừng cắt lưng chừng: `web` cần `backend`, `caddy` cần `web` (xem ghi chú trong compose).
COMPOSE_PROFILES=db,redis,minio

# --- Tên project + cổng ---
# Tên project tách container/volume của môi trường này khỏi môi trường khác
# (chạy chung một máy cũng không đè nhau).
COMPOSE_PROJECT_NAME=erp-svn-local
# HTTP_PORT/HTTPS_PORT/SITE_DOMAIN chỉ có tác dụng với service `caddy`.
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_DOMAIN=localhost

# --- PostgreSQL (service db) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=gan_app

# --- Backend auth ---
# KHÔNG khai APP_ENV ở đây: compose ghi cứng `APP_ENV: production` cho service backend
# (không cho phép lỡ tay deploy với guard JWT tắt).
# Sinh secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Tài khoản admin seed (đăng nhập bằng SEED_ADMIN_USERNAME) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
SEED_DEMO=true

# --- CORS: origin frontend được phép gọi API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Gốc URL của frontend — QR trên phiếu công nghệ trỏ về đây ---
# ĐỂ TRỐNG = lấy origin ĐẦU TIÊN của CORS_ORIGINS ở trên. Fallback đó là CHỦ Ý (deploy thường
# chỉ khai đúng một origin), nên biến này KHÔNG bắt buộc và không nằm trong danh sách REQUIRED
# của .github/workflows/deploy.yml.
# BẪY: ai thêm một origin nội bộ lên ĐẦU danh sách CORS_ORIGINS thì QR im lặng trỏ sang host đó —
# không lỗi, không cảnh báo, chỉ là điện thoại quét ra sai địa chỉ. Khai thẳng biến này khi
# CORS_ORIGINS có nhiều hơn một origin.
FRONTEND_BASE_URL=

# --- URL backend mà bundle FE sẽ gọi (nướng vào lúc BUILD image `web`) ---
# RỖNG = same-origin: client gọi /api tương đối, nginx trong image proxy sang backend.
# Đây là giá trị đúng cho mọi triển khai có Caddy/nginx đứng trước. Chỉ đặt khác khi FE và BE
# nằm ở hai tên miền khác nhau (vd https://api.example.com).
# Đổi biến này phải `up --build` lại service `web` thì bundle mới nhận.
VITE_API_BASE_URL=

# --- MinIO (kho file) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=svn-files

# --- Cổng loopback của `web` (nginx + bundle FE) ---
# Caddy CÙNG project gọi `web:80` qua mạng nội bộ, không cần cổng này. Nó tồn tại để Caddy của
# project KHÁC với tới — cụ thể: staging đi nhờ TLS của Caddy production (xem Caddyfile).
# Mỗi môi trường một cổng: production 8180, staging 8181.
WEB_PORT=8180
# Địa chỉ bind. Mặc định 127.0.0.1 (chỉ loopback của host).
# Môi trường nào cần Caddy của project KHÁC gọi vào thì phải đặt 172.17.0.1 — đúng IP mà
# `host.docker.internal` phân giải ra từ trong container. Để 127.0.0.1 sẽ bị Connection
# refused → Caddy trả 502. Không lộ ra Internet: 172.17.0.1 là IP nội bộ của host.
WEB_BIND=127.0.0.1

# --- Cho Caddy gánh thêm domain staging (chỉ khai ở môi trường CÓ chạy caddy) ---
# Không khai ⇒ mặc định `stg.localhost` ⇒ chứng chỉ NỘI BỘ, không gọi Let's Encrypt.
# STG_DOMAIN=stgsvn.superbai.io
# STG_UPSTREAM=host.docker.internal:8181

# --- Cổng loopback của Postgres/Redis/MinIO ---
# Lệch mặc định 5432/6379/9000/9001 vì chúng hay bị service khác chiếm sẵn (máy dev thường đã
# cài Postgres; trên VPS thì 5432 và 9001 đã thuộc stack myanphu-staging).
# Chỉ publish 127.0.0.1, KHÔNG ra Internet — có để backend chạy ngoài container nối vào được.
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9002

# REDIS_URL và MINIO_ENDPOINT do docker-compose.prod.yml đặt sẵn (trỏ vào service nội bộ),
# không cần khai ở đây.

# ============================================================================
# STAGING (nhánh `dev`) — khác production đúng mấy dòng này
#
#   COMPOSE_PROFILES      db,redis,minio,backend,web   ← KHÔNG có `caddy`
#   COMPOSE_PROJECT_NAME  erp-svn-stg
#   WEB_PORT              8181            (production 8180 — KHÔNG được trùng)
#   SITE_DOMAIN           stgsvn.superbai.io
#   CORS_ORIGINS          https://stgsvn.superbai.io
#   SEED_DEMO             true            (staging nên có sẵn dữ liệu để bấm thử)
#   POSTGRES_PORT / REDIS_PORT / MINIO_API_PORT / MINIO_CONSOLE_PORT
#                         5435 / 6382 / 9012 / 9004   (production 5434/6381/9011/9003)
#   HTTP_PORT / HTTPS_PORT   BỎ HẲN — staging không dựng caddy nên hai biến này vô nghĩa,
#                            và để 80/443 sẽ tranh cổng với production.
#
# Và trong `.env` của PRODUCTION phải khai để Caddy của nó gánh staging:
#   STG_DOMAIN=stgsvn.superbai.io
#   STG_UPSTREAM=host.docker.internal:8181
#   WEB_PORT=8180
# ============================================================================

# ============================================================================
# TRIỂN KHAI THẬT — đổi đúng những dòng này rồi mới `docker compose up -d --build`
#
#   COMPOSE_PROFILES      db,redis,minio,backend,web,caddy   ← QUAN TRỌNG NHẤT
#   COMPOSE_PROJECT_NAME  erp-svn            (staging: erp-svn-stg)
#   HTTP_PORT / HTTPS_PORT  80 / 443         (staging chung VPS: 8090 / 8443)
#   SITE_DOMAIN           svn.superbai.io    (staging: stg.svn.superbai.io)
#   CORS_ORIGINS          https://<SITE_DOMAIN>
#   SEED_DEMO             false              (production: KHÔNG seed dữ liệu demo)
#   POSTGRES_PORT / REDIS_PORT / MINIO_API_PORT / MINIO_CONSOLE_PORT
#                         phải LỆCH giữa prod và staging nếu chạy chung một VPS
#
#   Sinh mới, KHÔNG dùng lại giá trị dev — mỗi cái một chuỗi ngẫu nhiên riêng:
#   JWT_SECRET (≥32 ký tự, thiếu là backend TỪ CHỐI khởi động)
#   POSTGRES_PASSWORD · SEED_ADMIN_PASSWORD · MINIO_ROOT_USER · MINIO_ROOT_PASSWORD
#
# `deploy.yml` kiểm các khoá này trước khi `up`; thiếu là dừng ngay kèm thông báo,
# không để backend crash-loop.
# ============================================================================
