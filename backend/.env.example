# Backend environment (copy to backend/.env for local non-Docker runs).
# NEVER commit a real .env — secrets load from the environment (docs/SECURITY.md).

# Local dev without Docker uses SQLite; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./dev.db

# Auth — CHANGE jwt_secret in any real deployment.
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded admin user (no self-registration this sprint).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin

# Comma-separated allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
