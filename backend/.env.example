# Backend environment (copy to backend/.env for local non-Docker runs).
# NEVER commit a real .env — secrets load from the environment (docs/SECURITY.md).

# Local dev without Docker uses SQLite; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./dev.db

# Deployment environment. With APP_ENV=production the backend REFUSES to start
# unless JWT_SECRET is a strong (>=32 random chars), non-default value.
APP_ENV=development
# Auth — CHANGE jwt_secret in any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded admin user (no self-registration this spec). Login is by SEED_ADMIN_USERNAME.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin

# Seed spec-06 CRM demo staff (tpkd / sale1 / sale2, pw=password123) + customers so the
# Khách hàng screen shows own/department/all scope data. Leave false for the test suite.
SEED_DEMO=false

# Comma-separated allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
